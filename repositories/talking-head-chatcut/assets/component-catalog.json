{
  "version": 6,
  "instantiation": {
    "tool": "create_motion_graphic_from_code",
    "sourceMode": "inline-jsx",
    "storeLocalJsxFiles": false,
    "fullFrameUsesCurrentCanvas": true,
    "overlayUsesTightNaturalBox": true,
    "placeWithExplicitTimelineRectangle": true
  },
  "templateSystem": {
    "reference": "../references/semantic-template-system.md",
    "definitions": "semantic-template-system.json",
    "schema": "semantic-template-system.schema.json",
    "planSchema": "semantic-template-plan.schema.json",
    "contract": "template-system-contract.json",
    "validateWith": "../scripts/validate_template_system.py --plan <path>",
    "selectionOrder": ["mustHonor-userOverride", "viewerJob", "informationStructure", "motionSignature", "aspect", "sceneInstance", "transitionInstance"],
    "sourceOfTruthForNewProjects": true
  },
  "semanticMotionLibrary": {
    "reference": "../references/semantic-motion.md",
    "primitives": "motion-primitives.json",
    "patterns": "semantic-motion-patterns.json",
    "sceneComponents": "semantic-scene-components.json",
    "selectionOrder": ["viewerJob", "sceneComponentId", "semanticPatternId", "primitiveIds", "primitiveAssignments", "motionIntensity"],
    "planSchema": "semantic-motion-plan.schema.json",
    "validateWith": "../scripts/validate_semantic_motion.py --plan <path>",
    "compatibilityOnly": true,
    "supersededForSelectionBy": "semantic-template-system.json"
  },
  "visualOrchestration": {
    "reference": "../references/visual-orchestration.md",
    "contract": "visual-orchestration-contract.json",
    "validateWith": "../scripts/validate_visual_orchestration.py --plan <path>",
    "dimensions": ["layoutSilhouette", "entranceMechanism", "motionPath", "informationPersistence", "materialTreatment"]
  },
  "templatePolicy": {
    "inspectCurrentLibrary": true,
    "minimumScore": 8,
    "scoreDimensions": ["aspect-fit", "chinese-readability", "style-fit", "editability", "timing-control"],
    "templatePreferredFor": ["transition", "builtin-zoom", "simple-title", "low-information-prompt", "fx"],
    "componentPreferredFor": ["core-information-structure", "precise-speech-sync", "recurring-brand-identity"],
    "lockedVisualDescriptionIsSourceOfTruth": true,
    "createNewPatternWhenExistingScoreBelow": 8
  },
  "syncContract": "visual-sync-contract.json",
  "evolutionPolicy": {
    "reference": "../references/template-evolution.md",
    "autonomousAfterS9": true,
    "candidateSuccessfulUses": 1,
    "provenSuccessfulUses": 2,
    "storeProjectAssetIds": false,
    "storeLocalJsxFiles": false,
    "cosmeticChangesDoNotCreatePatterns": true
  },
  "reuseRule": "Reuse one MG asset only when viewer job, information structure, and visual form all match.",
  "statePropertyConvention": {
    "visibleCount": "Number of semantic units currently visible.",
    "activeIndex": "Zero-based semantic unit currently emphasized or active.",
    "progress": "Continuous progress value when a path or transfer needs interpolation."
  },
  "components": [
    {
      "id": "FullScreenInfo",
      "viewerJob": "Understand one chapter, definition, or conclusion.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["title", "subtitle", "keyword", "chapterNumber", "primaryColor", "accentColor", "fontFamily", "transparentBackground"]
    },
    {
      "id": "TalkingHeadPipShell",
      "viewerJob": "Keep speaker presence while the main area explains information.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["label", "borderColor", "borderWidth", "cornerRadius", "shadowEnabled"]
    },
    {
      "id": "AccumulatingRows",
      "viewerJob": "Reveal and retain two to five parallel concepts.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["item1Title", "item1Body", "item2Title", "item2Body", "item3Title", "item3Body", "item4Title", "item4Body", "item5Title", "item5Body", "syncMode", "cue1", "cue2", "cue3", "cue4", "cue5", "visibleCount", "activeIndex", "accentColor", "fontFamily"]
    },
    {
      "id": "MediaFrame",
      "viewerJob": "Show real media while retaining speaker or contextual framing.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["title", "image", "video", "fitMode", "borderColor", "cornerRadius", "transparentBackground"]
    },
    {
      "id": "ZoomAnnotation",
      "viewerJob": "Locate one important control, number, or piece of evidence.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["label", "targetX", "targetY", "targetWidth", "targetHeight", "arrowDirection", "stepStatus", "accentColor"]
    },
    {
      "id": "ComparePanel",
      "viewerJob": "See a before-after, right-wrong, or option difference immediately.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["leftTitle", "rightTitle", "leftImage", "rightImage", "leftVideo", "rightVideo", "layoutDirection", "highlightSide", "result", "accentColor"]
    },
    {
      "id": "ProcessMap",
      "viewerJob": "Understand sequence, causality, or system relationships.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["node1", "node2", "node3", "node4", "node5", "syncMode", "cue1", "cue2", "cue3", "cue4", "cue5", "visibleCount", "activeIndex", "direction", "connectorStyle", "accentColor", "fontFamily"]
    },
    {
      "id": "ProgressHeader",
      "viewerJob": "Know the current chapter or item within the whole structure.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["title", "current", "total", "displayMode", "accentColor"]
    },
    {
      "id": "KeyPointEmphasis",
      "viewerJob": "Remember one term, number, or conclusion.",
      "profiles": ["portrait-9-16", "landscape-16-9"],
      "properties": ["primaryText", "supportingText", "number", "unit", "emphasisMode", "primaryColor", "accentColor", "fontFamily"]
    }
  ],
  "patterns": [
    {
      "id": "sentence-emphasis",
      "name": "句意强调",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand and remember one opening claim or core sentence.",
      "suitableDescriptions": ["opening-claim", "single-conclusion", "chapter-thesis"],
      "informationStructure": "kicker-title-supporting-line",
      "mechanism": "Full-frame typographic hierarchy with one controlled emphasis beat.",
      "syncModes": ["reveal", "highlight"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["kicker", "title", "body", "cueBody", "accentColor", "fontFamily", "transparentBackground"],
      "limitations": ["landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "chapter-divider",
      "name": "章节转场",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Recognize a structural chapter change without losing continuity.",
      "suitableDescriptions": ["chapter-open", "topic-switch", "numbered-section"],
      "informationStructure": "chapter-number-title-short-definition",
      "mechanism": "Progress line and chapter marker settle before the supporting definition.",
      "syncModes": ["reveal", "state-change"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["chapterNumber", "title", "body", "cueBody", "progress", "accentColor", "fontFamily"],
      "limitations": ["landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "accumulating-list",
      "name": "递进清单",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Follow several parallel or sequential items while retaining earlier ones.",
      "suitableDescriptions": ["steps", "parallel-concepts", "requirements", "four-item-overview"],
      "informationStructure": "title-plus-two-to-five-retained-rows",
      "mechanism": "Rows reveal cumulatively or remain visible while the current row highlights.",
      "syncModes": ["reveal", "highlight"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "item1", "item2", "item3", "item4", "item5", "cue1", "cue2", "cue3", "cue4", "cue5", "visibleCount", "activeIndex"],
      "limitations": ["maximum-five-items", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "tool-constellation",
      "name": "工具星图",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "See a central capability and the tools or models connected to it.",
      "suitableDescriptions": ["ecosystem", "model-family", "hub-and-tools", "related-options"],
      "informationStructure": "one-core-plus-two-to-four-satellites",
      "mechanism": "Satellite nodes and connections activate around a central core.",
      "syncModes": ["state-change", "highlight"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "core", "item1", "item2", "item3", "item4", "cue1", "cue2", "cue3", "cue4", "visibleCount", "activeIndex"],
      "limitations": ["best-with-short-node-labels", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "task-pipeline",
      "name": "任务流程",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand how a task moves through ordered execution stages.",
      "suitableDescriptions": ["workflow", "agent-execution", "input-process-output", "multi-step-task"],
      "informationStructure": "two-to-five-ordered-stages",
      "mechanism": "Stages appear and retain state while a progress path advances.",
      "syncModes": ["state-change", "highlight", "reveal"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "stage1", "stage2", "stage3", "stage4", "stage5", "cue1", "cue2", "cue3", "cue4", "cue5", "visibleCount", "activeIndex", "progress"],
      "limitations": ["maximum-five-stages", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "terminal-runner",
      "name": "终端任务",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand that an agent or tool is executing concrete computer operations.",
      "suitableDescriptions": ["command-execution", "automation-run", "tool-use", "task-status"],
      "informationStructure": "command-or-task-lines-with-status",
      "mechanism": "Terminal-like lines enter and change from pending to done at speech cues.",
      "syncModes": ["reveal", "state-change"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "item1", "item2", "item3", "item4", "cue1", "cue2", "cue3", "cue4", "activeIndex"],
      "limitations": ["avoid-long-code", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "split-comparison",
      "name": "对比拆分",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Compare two concepts, products, or roles on a shared basis.",
      "suitableDescriptions": ["a-vs-b", "before-after", "model-vs-agent", "right-wrong"],
      "informationStructure": "left-right-or-top-bottom-comparison",
      "mechanism": "Two sides reveal independently, then a comparison marker or result resolves the relation.",
      "syncModes": ["reveal", "highlight", "state-change"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "leftTitle", "leftBody", "rightTitle", "rightBody", "cue1", "cue2", "cueBody", "highlightSide"],
      "limitations": ["portrait-prefers-stacked-when-copy-is-long", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "radial-system-map",
      "name": "关系蓝图",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand a system made of one center and several functional branches.",
      "suitableDescriptions": ["system-map", "core-and-capabilities", "architecture", "relationship-overview"],
      "informationStructure": "center-plus-two-to-four-related-nodes",
      "mechanism": "The center establishes context, then related nodes and links activate at cues.",
      "syncModes": ["state-change", "highlight"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "core", "item1", "item2", "item3", "item4", "cue1", "cue2", "cue3", "cue4", "visibleCount", "activeIndex"],
      "limitations": ["best-with-short-labels", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "repository-browser",
      "name": "开源仓库",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand what can be found inside a repository or resource library.",
      "suitableDescriptions": ["github-content", "resource-library", "repository-structure", "search-result"],
      "informationStructure": "repository-label-plus-resource-rows",
      "mechanism": "Repository structure appears first, then resource types reveal or highlight by cue.",
      "syncModes": ["reveal", "highlight", "state-change"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "repoName", "item1", "item2", "item3", "item4", "cue1", "cue2", "cue3", "cue4", "visibleCount", "activeIndex"],
      "limitations": ["not-a-literal-ui-screenshot", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "memory-stack",
      "name": "长期记忆",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand accumulated preferences, context, or memory layers.",
      "suitableDescriptions": ["memory", "personalization", "profile-layers", "context-retention"],
      "informationStructure": "two-to-four-memory-records-or-layers",
      "mechanism": "Memory records accumulate, then the relevant record highlights when referenced.",
      "syncModes": ["reveal", "highlight", "state-change"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "item1", "item2", "item3", "item4", "cue1", "cue2", "cue3", "cue4", "visibleCount", "activeIndex"],
      "limitations": ["avoid-dense-paragraphs", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "cross-device-route",
      "name": "多端入口",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand how one task or message moves across devices and platforms.",
      "suitableDescriptions": ["desktop-to-mobile", "multi-device", "message-route", "cross-platform-entry"],
      "informationStructure": "two-or-three-devices-plus-transfer-path",
      "mechanism": "Devices appear at cues and a task packet travels between them after both are established.",
      "syncModes": ["state-change", "media-focus", "reveal"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "device1", "device2", "device3", "cue1", "cue2", "cue3", "progress"],
      "limitations": ["maximum-three-devices", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "layered-summary",
      "name": "分层总结",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Review a multi-part framework and remember its hierarchy.",
      "suitableDescriptions": ["summary", "framework-review", "four-layer-system", "closing-map"],
      "informationStructure": "two-to-five-retained-summary-rows",
      "mechanism": "Rows accumulate or remain visible while an active scan marks the currently spoken layer.",
      "syncModes": ["reveal", "highlight", "state-change"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "item1", "item2", "item3", "item4", "item5", "cue1", "cue2", "cue3", "cue4", "cue5", "visibleCount", "activeIndex", "progress"],
      "limitations": ["maximum-five-layers", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-export-pass", "independent-review-pass"]
    },
    {
      "id": "prompt-result-portal",
      "name": "提示词传送门",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand how one text prompt becomes a generated visual result.",
      "suitableDescriptions": ["prompt-to-image", "input-to-output", "generation-process"],
      "informationStructure": "source-prompt-plus-transfer-path-plus-result-window",
      "mechanism": "The prompt enters first, a directional path advances, and the result aperture opens at the spoken outcome.",
      "syncModes": ["state-change", "reveal"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "prompt", "result", "model1", "model2", "model3", "cuePrompt", "cueTransfer", "cueResult"],
      "limitations": ["result-window-is-conceptual-unless-bound-to-real-media", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-review-pass", "independent-review-pass"]
    },
    {
      "id": "execution-radar",
      "name": "执行雷达",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Track several execution states around one active task without presenting a fake terminal.",
      "suitableDescriptions": ["agent-status", "execution-monitor", "multi-state-progress"],
      "informationStructure": "central-task-plus-three-to-five-status-sectors",
      "mechanism": "A radial sweep visits sectors and resolved states remain lit around the task core.",
      "syncModes": ["state-change", "highlight"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "task", "state1", "state2", "state3", "state4", "cue1", "cue2", "cue3", "cue4", "activeIndex"],
      "limitations": ["must-be-labeled-as-abstract-status-when-not-real-ui", "maximum-five-sectors", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-review-pass", "independent-review-pass"]
    },
    {
      "id": "misconception-shutter",
      "name": "误解纠正",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Replace a common misconception with the correct framework at an exact verbal turn.",
      "suitableDescriptions": ["myth-vs-reality", "correction", "not-x-but-y"],
      "informationStructure": "misconception-plus-negation-cue-plus-truth-panel",
      "mechanism": "The misconception stays readable until the negation cue, then a strike and shutter reveal the truth.",
      "syncModes": ["state-change", "reveal"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["kicker", "misconception", "truth", "cueMisconception", "cueNegation", "accentColor", "correctionColor"],
      "limitations": ["negation-cue-must-be-word-accurate", "truth-must-not-preempt-the-negation", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-review-pass", "independent-review-pass"]
    },
    {
      "id": "memory-orbit",
      "name": "记忆轨道",
      "status": "candidate",
      "successfulUses": 1,
      "viewerJob": "Understand how several memory types feed an accumulating collaboration core.",
      "suitableDescriptions": ["long-term-memory", "personalization-loop", "feedback-system"],
      "informationStructure": "central-experience-core-plus-three-memory-satellites",
      "mechanism": "Memory satellites enter at speech cues, connect to the core, and an orbit shows ongoing feedback without endless decoration.",
      "syncModes": ["state-change", "highlight"],
      "profiles": ["portrait-9-16"],
      "editableProperties": ["title", "core", "memory1", "memory2", "memory3", "cue1", "cue2", "cue3", "progress"],
      "limitations": ["orbit-must-stop-or-settle-after-the-semantic-window", "best-with-three-memory-types", "landscape-16-9-requires-new-layout-and-qa"],
      "qa": ["s7-pass", "s9-review-pass", "independent-review-pass"]
